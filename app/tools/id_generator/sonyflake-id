#!/usr/bin/env python3
import argparse
from sonyflake_id import generate_ids


def parse_machine_id(value: str) -> int:
    try:
        return int(value, 0)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("machine-id 必须是整数，例如 123 或 0x007b") from exc


def main() -> int:
    parser = argparse.ArgumentParser(description="生成 Sonyflake 分布式唯一 ID")
    parser.add_argument("-n", "--count", type=int, default=1, help="生成 ID 的数量，默认 1")
    parser.add_argument("--machine-id", type=parse_machine_id, help="可选机器号，范围 0x0000 到 0xffff")
    args = parser.parse_args()

    if args.count < 1:
        parser.error("count 必须大于等于 1")

    for sonyflake_id in generate_ids(args.count, machine_id=args.machine_id):
        print(sonyflake_id)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
